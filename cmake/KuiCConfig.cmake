# 仓库版（由 KUI 导出脚本按 SDK 包里的 cmake/KuiCConfig.cmake 生成）：与包里那份只差下面两处——
#   1. 前缀：运行库按当前平台取本仓库的 runtime/<平台>/（与 SDK 包里的 bin/、lib/ 逐字节相同、相对位置不变）；
#   2. 头文件：kui_c.h 与两个协议头在 c/include/，C++ Wrapper 的头在 include/（只有 kui-cpp 仓库有）。
# Repository variant generated from the SDK package's cmake/KuiCConfig.cmake: only the prefix (runtime/<platform>/)
# and the include directories (c/include/, include/) differ from the packaged file.
# KUI C ABI / source C++ Wrapper package config.
# Generated by scripts/release_sdk.ps1 (Windows) / scripts/package_c_sdk_posix.py
# (Linux, macOS); relocatable inside the C SDK archive (kui-c-sdk) and the C++
# Wrapper SDK archive (kui-cpp-wrapper-sdk). Both archives carry this same file:
# KuiC::C / KuiC::ExtensionAPI / KuiC::MediaAPI always exist, KuiC::Cpp only where
# the package actually ships cpp_wrapper/ (the Wrapper archive).

set(KuiC_VERSION "3.61.8")
if(WIN32)
    set(KuiC_FULL_PROFILE "Windows-x64-Full")
elseif(APPLE)
    set(KuiC_FULL_PROFILE "macOS-arm64-Full")
else()
    set(KuiC_FULL_PROFILE "Linux-x64-Full")
endif()

get_filename_component(_KUI_C_REPO "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(WIN32)
    set(_KUI_C_RUNTIME_PLATFORM "windows-x64")
elseif(APPLE)
    set(_KUI_C_RUNTIME_PLATFORM "macos-arm64")
else()
    set(_KUI_C_RUNTIME_PLATFORM "linux-x64")
endif()
set(_KUI_C_PREFIX "${_KUI_C_REPO}/runtime/${_KUI_C_RUNTIME_PLATFORM}")
if(NOT IS_DIRECTORY "${_KUI_C_PREFIX}/lib")
    set(KuiC_FOUND FALSE)
    set(KuiC_NOT_FOUND_MESSAGE
        "This repository has no ${_KUI_C_RUNTIME_PLATFORM} runtime (${_KUI_C_PREFIX}); 本仓库没有该平台的运行库")
    return()
endif()

# CMake 的 Debug 配置和 MSVC 的 Debug CRT 是两件事。C ABI 不跨边界传 CRT 对象，应用用哪种 CRT
# （/MD、/MDd、/MTd）都能调同一份 Release 版 kui_c.dll。
#
# 公开的 C 包与 Wrapper 包只带 Release 运行库（2026-11-20 起没有 bin/debug、lib/debug）：Debug 配置同样链接、
# 部署 bin/ 与 lib/ 里的 Release 版，KuiC_DEBUG_VARIANT_SELECTED 为 FALSE。下面的 KuiC_USE_DEBUG_VARIANT（与
# C++ SDK 的 Kui_USE_DEBUG_VARIANT 同一含义）只在包里另有 bin/debug/kui_c.dll 时才起作用；没有时开 / 关结果相同，
# 旧工程里写着 set(KuiC_USE_DEBUG_VARIANT OFF) 的照样能用。
#
# Linux / macOS 包只有一套（没有 Debug CRT 之分）：lib/ 里的 libkui_c 与 libkui 既用来链接也是运行库，
# 可执行程序经 RPATH 找到它们。
option(KuiC_USE_DEBUG_VARIANT
    "Use the packaged Debug-CRT kui_c.dll / kui.dll for the Debug configuration" ON)
if(WIN32 AND KuiC_USE_DEBUG_VARIANT AND EXISTS "${_KUI_C_PREFIX}/bin/debug/kui_c.dll")
    set(KuiC_DEBUG_VARIANT_SELECTED TRUE)
    set(_KUI_C_DEBUG_BIN "${_KUI_C_PREFIX}/bin/debug")
    set(_KUI_C_DEBUG_LIB "${_KUI_C_PREFIX}/lib/debug")
else()
    set(KuiC_DEBUG_VARIANT_SELECTED FALSE)
    set(_KUI_C_DEBUG_BIN "${_KUI_C_PREFIX}/bin")
    set(_KUI_C_DEBUG_LIB "${_KUI_C_PREFIX}/lib")
endif()

if(NOT TARGET KuiC::C AND WIN32)
    add_library(KuiC::C SHARED IMPORTED)
    set_target_properties(KuiC::C PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_KUI_C_REPO}/c/include"
        IMPORTED_CONFIGURATIONS "Release;Debug"
        IMPORTED_LOCATION_RELEASE "${_KUI_C_PREFIX}/bin/kui_c.dll"
        IMPORTED_IMPLIB_RELEASE "${_KUI_C_PREFIX}/lib/kui_c.lib"
        IMPORTED_LOCATION_DEBUG "${_KUI_C_DEBUG_BIN}/kui_c.dll"
        IMPORTED_IMPLIB_DEBUG "${_KUI_C_DEBUG_LIB}/kui_c.lib"
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
        MAP_IMPORTED_CONFIG_MINSIZEREL Release)
elseif(NOT TARGET KuiC::C)
    add_library(KuiC::C SHARED IMPORTED)
    set_target_properties(KuiC::C PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_KUI_C_REPO}/c/include"
        IMPORTED_LOCATION "${_KUI_C_PREFIX}/lib/libkui_c${CMAKE_SHARED_LIBRARY_SUFFIX}")
    if(NOT APPLE)
        # GNU ld 链接可执行程序时要解析 libkui_c 依赖的 libkui（间接依赖），在这里告诉它去哪找；
        # 运行期由 RPATH 负责。macOS 的两级命名空间不需要。
        set_property(TARGET KuiC::C APPEND PROPERTY
            INTERFACE_LINK_OPTIONS "LINKER:-rpath-link,${_KUI_C_PREFIX}/lib")
    endif()
endif()

# 源码 C++ Wrapper 单独成包（kui-cpp-wrapper-sdk）：C 包只有纯 C，没有 cpp_wrapper/，这里就不定义 KuiC::Cpp，
# 链接它的工程在配置期报「找不到目标 KuiC::Cpp」，而不是编到一半才缺头文件。两个包用同一份配置，
# 是否带 Wrapper 写在 KuiC_CPP_WRAPPER_FOUND。
if(EXISTS "${_KUI_C_REPO}/include/kui/kui.h")
    set(KuiC_CPP_WRAPPER_FOUND TRUE)
else()
    set(KuiC_CPP_WRAPPER_FOUND FALSE)
endif()
if(KuiC_CPP_WRAPPER_FOUND AND NOT TARGET KuiC::Cpp)
    add_library(KuiC::Cpp INTERFACE IMPORTED)
    set_target_properties(KuiC::Cpp PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES
            "${_KUI_C_REPO}/include;${_KUI_C_REPO}/c/include"
        INTERFACE_LINK_LIBRARIES KuiC::C
        INTERFACE_COMPILE_FEATURES cxx_std_17)
endif()

# Extension/media plugins cross a separate pure-C protocol boundary and do not
# link kui_c.dll. These authoring targets make that distinction explicit while
# still giving CMake consumers the canonical protocol headers from this SDK.
if(NOT TARGET KuiC::ExtensionAPI)
    add_library(KuiC::ExtensionAPI INTERFACE IMPORTED)
    set_target_properties(KuiC::ExtensionAPI PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_KUI_C_REPO}/c/include")
endif()

if(NOT TARGET KuiC::MediaAPI)
    add_library(KuiC::MediaAPI INTERFACE IMPORTED)
    set_target_properties(KuiC::MediaAPI PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_KUI_C_REPO}/c/include")
endif()

# 包里的头（kui_c.h、扩展 / 媒体协议头、cpp_wrapper/include）带 UTF-8 的中文注释。中文 Windows 上 MSVC 默认按
# 代码页 936（GBK）读源文件，多字节字符会吞掉行尾换行、把下一行代码并进注释（3.61.8 发版验收里只写一行
# #include <kui/kui.h> 的 Wrapper 使用方因此报上百个错误）。与 C++ SDK 的 Kui::Kui 一样把 /utf-8 作为使用要求
# 传给每个使用方；KuiC::Cpp 经 KuiC::C 继承。重复 find_package 不重复追加。
if(MSVC)
    foreach(_kui_c_target KuiC::C KuiC::ExtensionAPI KuiC::MediaAPI)
        get_target_property(_kui_c_options ${_kui_c_target} INTERFACE_COMPILE_OPTIONS)
        if(NOT _kui_c_options OR NOT "/utf-8" IN_LIST _kui_c_options)
            set_property(TARGET ${_kui_c_target} APPEND PROPERTY INTERFACE_COMPILE_OPTIONS /utf-8)
        endif()
    endforeach()
    unset(_kui_c_options)
    unset(_kui_c_target)
endif()

function(kui_c_copy_runtime_dlls target)
    # Linux / macOS：libkui_c 与 libkui 经 RPATH 找到，不复制；按可执行文件目录加载的扩展 / 媒体插件
    # （包里 bin/ 的那些）与 Windows 一样放到目标旁边。
    #
    # 2026-11-20 起 SDK 包的 bin/ 只有运行库，不带预编译示例程序与 assets/（它们在单独的预编译示例包里）。
    # C 包的 bin/ 也不带 hello 示例扩展：要运行加载它的示例，先用包里 extensions/hello 编出来放到程序旁边；
    # C++ Wrapper 包没有 hello 的源码，bin/ 里带着它，这里照常部署。
    #
    # 同一个目录下的示例目标默认共用一个输出目录。过去每个目标各挂一份
    # POST_BUILD 拷贝，并行构建时多个 `cmake -E copy_if_different` 会同时写同一
    # 个目的文件：实测 `--parallel 8` 构建 211 个 canonical C examples 会报
    # "Error copying file (if different)" 并以 MSB3073 整体失败。
    #
    # 因此本目录只让第一个调用方真正执行拷贝，其余目标依赖它——DLL 仍然落在
    # 可执行文件旁边，但不会并发写同一个文件。目标若自带 RUNTIME_OUTPUT_DIRECTORY
    # 覆盖，说明它的输出目录可能与 anchor 不同，此时退回逐目标拷贝。
    get_target_property(_kui_c_target_outdir ${target} RUNTIME_OUTPUT_DIRECTORY)
    if(NOT _kui_c_target_outdir)
        get_property(_kui_c_deploy_anchor DIRECTORY
                     PROPERTY KUI_C_RUNTIME_DEPLOY_ANCHOR)
        if(_kui_c_deploy_anchor)
            if(NOT _kui_c_deploy_anchor STREQUAL "${target}")
                add_dependencies(${target} ${_kui_c_deploy_anchor})
            endif()
            return()
        endif()
        set_property(DIRECTORY PROPERTY KUI_C_RUNTIME_DEPLOY_ANCHOR "${target}")
    endif()

    if(WIN32)
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                    "$<TARGET_FILE:KuiC::C>" "$<TARGET_FILE_DIR:${target}>"
            COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                    "$<IF:$<CONFIG:Debug>,${_KUI_C_DEBUG_BIN}/kui.dll,${_KUI_C_PREFIX}/bin/kui.dll>"
                    "$<TARGET_FILE_DIR:${target}>"
            COMMAND_EXPAND_LISTS
            VERBATIM)
        file(GLOB _KUI_C_OPTIONAL_RUNTIME
            "${_KUI_C_PREFIX}/bin/kui_ext_*.dll"
            "${_KUI_C_PREFIX}/bin/kui_media_*.dll"
            "${_KUI_C_PREFIX}/bin/avcodec-*.dll"
            "${_KUI_C_PREFIX}/bin/avformat-*.dll"
            "${_KUI_C_PREFIX}/bin/avutil-*.dll"
            "${_KUI_C_PREFIX}/bin/swresample-*.dll"
            "${_KUI_C_PREFIX}/bin/swscale-*.dll"
            "${_KUI_C_PREFIX}/bin/LICENSE.FFmpeg*.txt"
            "${_KUI_C_PREFIX}/bin/pdfium.dll"
            "${_KUI_C_PREFIX}/bin/*.filamat")
    else()
        file(GLOB _KUI_C_OPTIONAL_RUNTIME
            "${_KUI_C_PREFIX}/bin/libkui_ext_*${CMAKE_SHARED_LIBRARY_SUFFIX}"
            "${_KUI_C_PREFIX}/bin/libkui_media_*${CMAKE_SHARED_LIBRARY_SUFFIX}"
            "${_KUI_C_PREFIX}/bin/libpdfium${CMAKE_SHARED_LIBRARY_SUFFIX}"
            "${_KUI_C_PREFIX}/bin/libav*"
            "${_KUI_C_PREFIX}/bin/libsw*"
            "${_KUI_C_PREFIX}/bin/LICENSE.FFmpeg*.txt"
            "${_KUI_C_PREFIX}/bin/*.filamat")
    endif()
    foreach(_runtime IN LISTS _KUI_C_OPTIONAL_RUNTIME)
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                    "${_runtime}" "$<TARGET_FILE_DIR:${target}>"
            VERBATIM)
    endforeach()
endfunction()

set(KuiC_FOUND TRUE)
